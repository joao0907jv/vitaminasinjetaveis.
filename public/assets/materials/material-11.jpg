<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 580" width="420" height="580" fill="none">
  <!-- Poster Background -->
  <rect width="420" height="580" fill="#ffffff" rx="16"/>
  <rect x="0" y="0" width="420" height="580" stroke="#e2e8f0" stroke-width="2" rx="16"/>

  <!-- Header Banner -->
  <rect x="0" y="0" width="420" height="110" fill="#4338ca" rx="16"/>
  <rect x="0" y="90" width="420" height="20" fill="#4338ca"/>

  <!-- Badge Top Left -->
  <rect x="20" y="14" width="130" height="18" rx="9" fill="#3730a3"/>
  <text x="85" y="26" text-anchor="middle" font-family="system-ui, sans-serif" font-size="8.5" font-weight="800" fill="#ffffff" letter-spacing="0.08em">GUIA DE CONSULTA</text>

  <!-- Title -->
  <text x="20" y="60" font-family="'Archivo Black', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff" letter-spacing="-0.02em">COMPLEXO B</text>

  <!-- Subtitle Red/Orange Pill -->
  <rect x="20" y="70" width="260" height="18" rx="4" fill="#dc2626"/>
  <text x="150" y="82" text-anchor="middle" font-family="system-ui, sans-serif" font-size="8.5" font-weight="800" fill="#ffffff" letter-spacing="0.04em">B1 + B2 + B3 + B5 + B6 + B12</text>

  <!-- Amber Vial Graphic on Top Right -->
  <g transform="translate(325, 12)">
    <!-- Vial Cap -->
    <rect x="18" y="4" width="28" height="10" rx="3" fill="#cbd5e1" stroke="#64748b"/>
    <rect x="20" y="12" width="24" height="4" fill="#94a3b8"/>
    <!-- Vial Body -->
    <rect x="14" y="16" width="36" height="66" rx="6" fill="#d97706" stroke="#b45309" stroke-width="1.5"/>
    <rect x="18" y="22" width="28" height="52" fill="#b45309" opacity="0.6"/>
    <!-- Label -->
    <rect x="17" y="28" width="30" height="40" rx="2" fill="#ffffff"/>
    <text x="32" y="42" text-anchor="middle" font-family="system-ui, sans-serif" font-size="6.5" font-weight="900" fill="#1e293b">COMP B</text>
    <rect x="20" y="48" width="24" height="10" rx="2" fill="#facc15"/>
    <text x="32" y="55" text-anchor="middle" font-family="system-ui, sans-serif" font-size="4.8" font-weight="800" fill="#854d0e">2 mL Ampola</text>
    <text x="32" y="64" text-anchor="middle" font-family="system-ui, sans-serif" font-size="4" font-weight="700" fill="#64748b">USO IM / IV</text>
  </g>

  <!-- Section 1: O Que É? -->
  <rect x="20" y="120" width="380" height="58" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
  <rect x="20" y="120" width="380" height="20" rx="8" fill="#4338ca" opacity="0.12"/>
  <text x="30" y="134" font-family="system-ui, sans-serif" font-size="9" font-weight="800" fill="#4338ca">💡 O QUE É?</text>
  <text x="30" y="152" font-family="system-ui, sans-serif" font-size="9" fill="#334155" width="360">Fórmula balanceada de vitaminas hidrossolúveis que sustentam a bioenergétic</text>
  <text x="30" y="166" font-family="system-ui, sans-serif" font-size="9" fill="#334155" width="360">a mitocondrial e transmissão neural.</text>

  <!-- Section 2: Benefícios -->
  <rect x="20" y="186" width="380" height="105" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
  <rect x="20" y="186" width="380" height="20" rx="8" fill="#4338ca" opacity="0.12"/>
  <text x="30" y="200" font-family="system-ui, sans-serif" font-size="9" font-weight="800" fill="#4338ca">⚡ PRINCIPAIS BENEFÍCIOS</text>
  
    <circle cx="32" cy="215" r="4" fill="#4338ca"/>
    <text x="44" y="219" font-family="system-ui, sans-serif" font-size="10" font-weight="600" fill="#334155">Disposição e energia</text>
  
    <circle cx="32" cy="235" r="4" fill="#4338ca"/>
    <text x="44" y="239" font-family="system-ui, sans-serif" font-size="10" font-weight="600" fill="#334155">Suporte neurológico</text>
  
    <circle cx="32" cy="255" r="4" fill="#4338ca"/>
    <text x="44" y="259" font-family="system-ui, sans-serif" font-size="10" font-weight="600" fill="#334155">Função cognitiva</text>
  
    <circle cx="32" cy="275" r="4" fill="#4338ca"/>
    <text x="44" y="279" font-family="system-ui, sans-serif" font-size="10" font-weight="600" fill="#334155">Saúde de pele e unhas</text>
  

  <!-- Section 3: Tabela de Apresentações -->
  <rect x="20" y="298" width="380" height="145" rx="8" fill="#ffffff" stroke="#e2e8f0"/>
  <rect x="20" y="298" width="380" height="22" rx="8" fill="#4338ca"/>
  <text x="30" y="313" font-family="system-ui, sans-serif" font-size="9" font-weight="800" fill="#ffffff">📋 APRESENTAÇÕES COMUNS & DOSES</text>

  <!-- Table Head -->
  <rect x="20" y="320" width="380" height="18" fill="#f1f5f9"/>
  <text x="30" y="332" font-family="system-ui, sans-serif" font-size="8" font-weight="800" fill="#475569">PRINCÍPIO</text>
  <text x="160" y="332" font-family="system-ui, sans-serif" font-size="8" font-weight="800" fill="#475569">CONCENTRAÇÃO</text>
  <text x="270" y="332" font-family="system-ui, sans-serif" font-size="8" font-weight="800" fill="#475569">VOLUME</text>
  <text x="350" y="332" font-family="system-ui, sans-serif" font-size="8" font-weight="800" fill="#475569">VIA</text>
  
    <rect x="20" y="340" width="380" height="22" fill="#f8fafc" />
    <text x="30" y="355" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#1e293b">B1</text>
    <text x="160" y="355" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Tiamina</text>
    <text x="270" y="355" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Metabolismo de glicose</text>
    <text x="350" y="355" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#4338ca">Energia cerebral</text>
  
    <rect x="20" y="364" width="380" height="22" fill="#ffffff" />
    <text x="30" y="379" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#1e293b">B2</text>
    <text x="160" y="379" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Riboflavina</text>
    <text x="270" y="379" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Cadeia respiratória</text>
    <text x="350" y="379" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#4338ca">Respiração celular</text>
  
    <rect x="20" y="388" width="380" height="22" fill="#f8fafc" />
    <text x="30" y="403" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#1e293b">B3</text>
    <text x="160" y="403" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Niacina</text>
    <text x="270" y="403" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Síntese de NAD/NADH</text>
    <text x="350" y="403" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#4338ca">Reparo celular</text>
  
    <rect x="20" y="412" width="380" height="22" fill="#ffffff" />
    <text x="30" y="427" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#1e293b">B6 / B12</text>
    <text x="160" y="427" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Piridoxina / Cobalamina</text>
    <text x="270" y="427" font-family="system-ui, sans-serif" font-size="9" fill="#475569">Neurotransmissores</text>
    <text x="350" y="427" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#4338ca">Mielina e humor</text>
  

  <!-- Section 4: Vias e Cuidados -->
  <rect x="20" y="450" width="185" height="74" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
  <text x="28" y="466" font-family="system-ui, sans-serif" font-size="8.5" font-weight="800" fill="#4338ca">💉 VIAS DE APLICAÇÃO</text>
  <text x="28" y="482" font-family="system-ui, sans-serif" font-size="8" fill="#475569">IM profunda (2 mL) ou diluído em inf</text>
  <text x="28" y="495" font-family="system-ui, sans-serif" font-size="8" fill="#475569">usão IV lenta.</text>

  <rect x="215" y="450" width="185" height="74" rx="8" fill="#fef2f2" stroke="#fecaca"/>
  <text x="223" y="466" font-family="system-ui, sans-serif" font-size="8.5" font-weight="800" fill="#dc2626">⚠️ CUIDADOS & SEGURANÇA</text>
  <text x="223" y="482" font-family="system-ui, sans-serif" font-size="8" fill="#7f1d1d">Possível rubor facial transitório p</text>
  <text x="223" y="495" font-family="system-ui, sans-serif" font-size="8" fill="#7f1d1d">or vasodilatação de niacina. Não congelar.</text>

  <!-- Bottom Notice -->
  <rect x="20" y="534" width="380" height="30" rx="6" fill="#fef2f2" stroke="#f87171"/>
  <text x="210" y="552" text-anchor="middle" font-family="system-ui, sans-serif" font-size="7.5" font-weight="700" fill="#b91c1c">📢 MATERIAL INFORMATIVO DE APOIO — NÃO SUBSTITUI ORIENTAÇÃO PROFISSIONAL</text>
</svg>